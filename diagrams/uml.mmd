classDiagram
    class Owner {
        +str first_name
        +str last_name
        +list~Pet~ pets
        +list~Schedule~ schedules
        +full_name() str
        +add_pet(pet: Pet) None
        +get_all_tasks() list~Task~
        +set_schedule(schedule: Schedule) None
        +get_schedule(date: str) Schedule
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +edit_task(title: str, task: Task) None
        +remove_task(title: str) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str frequency
        +str pet_name
        +bool completed
        +mark_complete() None
        +priority_value() int
    }

    class ScheduledTask {
        +Task task
        +str start_time
        +str end_time
    }

    class Schedule {
        +str date
        +str start_time
        +int available_minutes
        +list~ScheduledTask~ scheduled
        +list~Task~ skipped
        +total_minutes() int
        +has_conflict() bool
        +explain() str
    }

    class Scheduler {
        +generate_plan(owner: Owner, date: str, start_time: str, available_minutes: int) Schedule
        +sort_by_priority(tasks: list~Task~) list~Task~
    }

    Owner "1" --> "*" Pet : has
    Owner "1" --> "*" Schedule : has one per day
    Pet "1" --> "*" Task : needs
    Schedule "1" --> "*" ScheduledTask : contains
    ScheduledTask "1" --> "1" Task : wraps
    Scheduler ..> Owner : reads tasks from
    Scheduler ..> Schedule : creates
