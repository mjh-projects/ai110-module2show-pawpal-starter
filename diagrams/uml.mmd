classDiagram
    %% Action 1: Add a pet and owner profile  -> Owner, Pet
    %% Action 2: Add or edit a care task       -> Task (managed by Pet)
    %% Action 3: Generate today's schedule     -> Scheduler

    class Owner {
        +str name
        +int available_minutes
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +set_available_time(minutes: int) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +edit_task(title: str, task: Task) None
        +remove_task(title: str) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str frequency
        +bool completed
        +mark_complete() None
        +priority_value() int
    }

    class Scheduler {
        +Owner owner
        +list~Task~ scheduled
        +list~Task~ skipped
        +generate_plan() list~Task~
        +sort_by_priority(tasks: list~Task~) list~Task~
        +explain_plan() str
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : needs
    Scheduler --> Owner : plans for
    Scheduler ..> Task : schedules
